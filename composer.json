{
  "name": "lekoala/kaly-forms",
  "description": "Small framework-independent server-first forms DSL with progressive enhancement metadata",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas",
      "email": "thomas@lekoala.be"
    }
  ],
  "keywords": [
    "forms",
    "html",
    "server-side-rendering",
    "progressive-enhancement",
    "framework-independent"
  ],
  "homepage": "https://github.com/lekoala/kaly-forms",
  "support": {
    "issues": "https://github.com/lekoala/kaly-forms/issues",
    "source": "https://github.com/lekoala/kaly-forms"
  },
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "carthage-software/mago": "^1.50",
    "latte/latte": "^3.1",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12",
    "twig/twig": "^3.30"
  },
  "suggest": {
    "latte/latte": "Idiomatic Latte output through Kaly\\Forms\\Bridge\\Latte\\FormExtension",
    "twig/twig": "Idiomatic Twig output through Kaly\\Forms\\Bridge\\Twig\\FormExtension, including a safe {{ form }}"
  },
  "autoload": {
    "psr-4": {
      "Kaly\\Forms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kaly\\Forms\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": [
      "@phpunit",
      "@phpstan",
      "@mago:lint",
      "@mago:guard",
      "@format:check"
    ],
    "phpunit": "@php -d zend.assertions=1 vendor/bin/phpunit",
    "phpstan": [
      "@phpstan:src",
      "@phpstan:tests"
    ],
    "phpstan:src": "phpstan analyse src --memory-limit=-1",
    "phpstan:tests": "phpstan analyse tests examples -c phpstan-tests.neon --memory-limit=-1",
    "mago:lint": "mago lint --minimum-report-level warning src tests examples",
    "mago:guard": "mago guard --minimum-report-level error",
    "mago:format": "mago fmt",
    "format:check": "mago fmt --check",
    "fmt": "@mago:format"
  },
  "prefer-stable": true
}
